# ==============================================================================
# IPMCAS Platform - Environment Variables Template
# Copy this file to .env or .env.local for local development.
# DO NOT COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Next.js - Public)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="IPMCAS - Internet Performance Measurement Platform"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
NEXT_PUBLIC_WS_BASE_URL="ws://localhost:8000"

# Supabase Public Keys (Safe for Browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# ------------------------------------------------------------------------------
# Backend Environment Variables (FastAPI - Private & Secure)
# ------------------------------------------------------------------------------
ENVIRONMENT="development"
DEBUG=true
API_PORT=8000
HOST="0.0.0.0"

# Database Connection (Supabase PostgreSQL Connection String)
# Example: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql+asyncpg://postgres:your_password@db.your_project.supabase.co:5432/postgres"

# Supabase Service Role Key (Backend Only - NEVER expose to browser)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# AI / LLM Configuration (Backend Only - NEVER expose to browser)
# ── Gemini (recommended) ──────────────────────────────────────────────────────
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash"      # Verified working. Also: gemini-3.6-flash, gemini-flash-latest

# ── OpenAI (alternative) ──────────────────────────────────────────────────────
# OPENAI_API_KEY="your-openai-api-key-here"
# OPENAI_MODEL="gpt-4o"

# ── Generic fallback (used if neither GEMINI_API_KEY nor OPENAI_API_KEY is set)
# LLM_API_KEY="your-llm-api-key-here"
# LLM_MODEL="gpt-4o"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

